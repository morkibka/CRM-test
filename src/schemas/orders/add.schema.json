{
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "required": ["order"],
      "properties": {
        "order": {
          "type": "object",
          "required": ["telephone", "country_iso_code"],
          "properties": {
            "telephone": {
              "type": "string",
              "description": "phone number in international format"
            },
            "country_iso_code": {
              "type": "string",
              "enum": ["AF","AX","AL","DZ","AS","AD","AO","AI","AQ","AG","AR","AM","AW","AU","AT","AZ","BS","BH","BD","BB","BY","BE","BZ","BJ","BM","BT","BO","BQ","BA","BW","BV","BR","IO","BN","BG","BF","BI","CV","KH","CM","CA","KY","CF","TD","CL","CN","CX","CC","CO","KM","CG","CD","CK","CR","CI","HR","CU","CW","CY","CZ","DK","DJ","DM","DO","EC","EG","SV","GQ","ER","EE","SZ","ET","FK","FO","FJ","FI","FR","GF","PF","TF","GA","GM","GE","DE","GH","GI","GR","GL","GD","GP","GU","GT","GG","GN","GW","GY","HT","HM","VA","HN","HK","HU","IS","IN","ID","IR","IQ","IE","IM","IL","IT","JM","JP","JE","JO","KZ","KE","KI","KP","KR","KW","KG","LA","LV","LB","LS","LR","LY","LI","LT","LU","MO","MK","MG","MW","MY","MV","ML","MT","MH","MQ","MR","MU","YT","MX","FM","MD","MC","MN","ME","MS","MA","MZ","MM","NA","NR","NP","NL","NC","NZ","NI","NE","NG","NU","NF","MP","NO","OM","PK","PW","PS","PA","PG","PY","PE","PH","PN","PL","PT","PR","QA","RE","RO","RU","RW","BL","SH","KN","LC","MF","PM","VC","WS","SM","ST","SA","SN","RS","SC","SL","SG","SX","SK","SI","SB","SO","ZA","GS","SS","ES","LK","SD","SR","SJ","SE","CH","SY","TW","TJ","TZ","TH","TL","TG","TK","TO","TT","TN","TR","TM","TC","TV","UG","UA","AE","GB","US","UM","UY","UZ","VU","VE","VN","VG","VI","WF","EH","YE","ZM","ZW"]
            },
            "name": { "type": "string" },
            "email": { "type": "string" },
            "comment": { "type": "string" },
            "address": {
              "type": "object",
              "properties": {
                "region": { "type": "string" },
                "sector": { "type": "string" },
                "city": { "type": "string" },
                "room": { "type": "string" },
                "floor": { "type": "string" },
                "house": { "type": "string" },
                "porch": { "type": "string" },
                "street": { "type": "string" },
                "building": { "type": "string" },
                "intercom": { "type": "string" },
                "index": { "type": "string" },
                "lat": { "type": "string" },
                "lon": { "type": "string" }
              }
            },
            "offers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cid", "count", "cost", "all_cost"],
                "properties": {
                  "id": { "type": "number" },
                  "cid": { "type": "number" },
                  "count": { "type": "number" },
                  "cost": { "type": "number" },
                  "proceeds": { "type": "number", "default": 0 },
                  "all_cost": { "type": "number" },
                  "discount": { "type": "number", "default": 0 },
                  "total": { "type": "number", "default": 0 },
                  "discount_type": {
                    "type": "string",
                    "enum": ["full", "proceeds"],
                    "default": "proceeds"
                  },
                  "discount_calc_type": {
                    "type": "string",
                    "enum": ["percent", "value"],
                    "default": "percent"
                  },
                  "salary_manager": { "type": "number", "default": 0 },
                  "salary_worker": { "type": "number", "default": 0 },
                  "salary_courier": { "type": "number", "default": 0 },
                  "method_manager": {
                    "type": "string",
                    "enum": ["unit", "percent", "fix"],
                    "default": "unit"
                  },
                  "method_worker": {
                    "type": "string",
                    "enum": ["unit", "percent", "fix"],
                    "default": "unit"
                  },
                  "method_courier": {
                    "type": "string",
                    "enum": ["unit", "percent", "fix"],
                    "default": "unit"
                  },
                  "all_salary_manager": { "type": "number", "default": 0 },
                  "all_salary_worker": { "type": "number", "default": 0 },
                  "all_salary_courier": { "type": "number", "default": 0 }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "number" },
    "api_id": { "type": "number" },
    "signature": { "type": "string" }
  }
}
